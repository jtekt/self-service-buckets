# OIDC SSO (Auth.js / next-auth) - any OIDC-compliant provider.
# Auth.js auto-detects these from the environment for the "oidc" provider.
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_ISSUER=
AUTH_SECRET=

# AWS credentials for the S3 / IAM SDK clients.
# Leave unset to use the default credential chain (e.g. an IAM role in-cluster).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Outbound HTTP proxy for AWS API calls (set only if the deployment requires one)
HTTPS_PROXY=

# Optional per-user bucket cap (unset = unlimited)
BUCKETS_LIMIT=

# Optional help link
NEXT_PUBLIC_HELP_URL=
